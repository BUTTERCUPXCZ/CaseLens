{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app's own title bar (loading screen and library page) may move, minimize, maximize and close the window, check for and install a signed CaseLens update, and open or show a file it saved in Downloads. Nothing else: no other files, no shell.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-check-update",
    "allow-install-update",
    "allow-open-download",
    "allow-reveal-download"
  ]
}
