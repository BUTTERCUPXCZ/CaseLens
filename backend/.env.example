# Copy to .env. Inside Docker the app uses the service names (db, rabbitmq).
# From your host (pytest, alembic) use the published ports 5434 / 5675.
DATABASE_URL=postgresql+psycopg://caselens:caselens@localhost:5434/caselens
# Background jobs (RabbitMQ). Management page: http://localhost:15675
RABBITMQ_URL=amqp://caselens:caselens@localhost:5675/

# --- The AI that writes and checks digests. Never commit a real key. ---
# Which one writes: openrouter | groq | deepseek | gemini. With AI_ONLY_CHOSEN=true no other AI takes over when it cannot answer.
AI_PROVIDER=openrouter
AI_ONLY_CHOSEN=true
OPENROUTER_API_KEY=
# A model id from https://openrouter.ai/models. A ":free" model writes two digests at a time (OpenRouter's free limits).
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_CHECKER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash      # the paid model
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GEMINI_WRITER_MODEL=gemini-3.5-flash
GEMINI_CHECKER_MODEL=gemini-3.5-flash
# How many digests are written at the same time (default 4; 2 on a free model)
# DIGEST_THREADS=4
# Cost guards
DIGEST_AI_DAILY_LIMIT=200
CASE_DIGEST_MONTHLY_LIMIT=2500
QUESTION_DAILY_LIMIT=500

# Lawphil politeness
LAWPHIL_BASE_URL=https://lawphil.net
LAWPHIL_USER_AGENT=caselens-internal/0.1 (internal law-student tool)
LAWPHIL_MIN_INTERVAL_SECONDS=1.0
LAWPHIL_TIMEOUT_SECONDS=30
LAWPHIL_MAX_RETRIES=3

# Oldest year read into the searchable catalog of Lawphil decisions
CATALOG_FIRST_YEAR=1987

# --- Hosting without separate workers (Render free plan + Supabase). See docs/DEPLOYMENT_PLAN.md ---
# QUEUE_BACKEND=threads                 # run the jobs inside the API; no RabbitMQ
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres   # Supabase Session pooler
# ACCESS_CODE=                          # a shared code; the app opens only after it is entered (empty = no gate)
# UPLOAD_MAX_MB=5
# UPLOAD_KEEP_DAYS=7                    # delete uploads older than this (0 = keep)
# RENDER_EXTERNAL_URL is set by Render itself: while work is waiting the site calls its own /health so it does not fall asleep.
